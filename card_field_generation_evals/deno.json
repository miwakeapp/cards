{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/path": "jsr:@std/path@^1.1.2",
    "zod": "npm:zod@^4.1.13"
  },
  "tasks": {
    "build:jmdict-entry-manifest": "deno run --allow-read=./archive,./cases --allow-write=../data/resources/jmdict scripts/build_jmdict_entry_manifest.ts",
    "doc:check": "deno doc --lint scripts/*.ts",
    "run": "deno run --env-file=../.env --allow-env --allow-net --allow-read=.. --allow-write=./generated --allow-sys=hostname scripts/run.ts",
    "test": "deno test --no-prompt -P"
  },
  "test": {
    "permissions": {
      "read": [
        "./archive",
        "./cases",
        "./resources",
        "../data/resources/jmdict"
      ],
      "sys": ["hostname"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "never"
  }
}
